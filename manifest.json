{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.1",
  "default_locale": "en",
  "description": "__MSG_appDescription__",
  "permissions": ["scripting", "activeTab", "downloads", "storage", "tabs", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "extract-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "__MSG_commandExtractCurrentTab__"
    },
    "open-link-audit": {
      "suggested_key": {
        "default": "Ctrl+Shift+U"
      },
      "description": "__MSG_commandOpenAudit__"
    },
    "extract-selected-text": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_commandExtractSelectedText__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "72": "icons/icon72.png",
    "128": "icons/icon128.png"
  }
}
